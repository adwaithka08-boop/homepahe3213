<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SJCET Front Page</title>
<style>
    body {
        margin: 0;
        padding: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: linear-gradient(to bottom, black, white);
        overflow: hidden;
        position: relative;
        font-family: Arial, sans-serif;
    }

    /* Background SJCET text */
    .background-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 160px;
        font-weight: 900;
        letter-spacing: 10px;
        background: linear-gradient(to bottom, red, black);
        -webkit-background-clip: text;
        color: transparent;
        opacity: 0.15;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
    }

    /* Buttons */
    .btn {
        padding: 18px 40px;
        font-size: 22px;
        background-color: white;
        color: black;
        border: 2px solid black;
        border-radius: 10px;
        cursor: pointer;
        margin: 10px;
        z-index: 2;
        transition: 0.3s;
    }

    .btn:hover {
        background-color: #e6e6e6;
    }

    /* HOD phone bottom-right */
    .phone {
        position: absolute;
        bottom: 20px;
        right: 20px;
        font-size: 20px;
        font-weight: bold;
    }

    .phone a {
        color: green;
        text-decoration: none;
    }
</style>
</head>

<body>

<div class="background-text">SJCET</div>

<button class="btn" onclick="window.location.href='exitpage.html'">
    REQUEST TO EXIT
</button>

<button class="btn" onclick="window.location.href='leavepage.html'">
    REQUEST TO LEAVE
</button>

<div class="phone">
    HOD: <a href="https://wa.me/911234567890" target="_blank">+91 12345 67890</a>
</div>

</body>
</html>
