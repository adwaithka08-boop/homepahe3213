<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Approval Page</title>
<style>
    body {
        margin: 0;
        padding: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background-color: black;
        font-family: Arial, sans-serif;
        position: relative;
        overflow: hidden;
    }

    /* Background SJCET text */
    .background-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 180px;
        font-weight: 900;
        opacity: 0.1;
        color: red;
        user-select: none;
        pointer-events: none;
        letter-spacing: 10px;
    }

    /* Buttons */
    .btn {
        padding: 18px 50px;
        font-size: 25px;
        margin: 15px;
        background-color: red;
        color: white;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: 0.3s ease;
        font-weight: bold;
        z-index: 2;
    }

    .btn:hover {
        background-color: #cc0000;
    }

    /* Reject button active state */
    .reject-active {
        background-color: darkred !important;
    }
</style>
</head>

<body>

<div class="background-text">SJCET</div>

<!-- Approve Button -->
<button class="btn" onclick="approve()">
    Approve
</button>

<!-- Reject Button -->
<button id="rejectBtn" class="btn" onclick="rejectAction()">
    Reject
</button>

<script>
    function approve() {
        // WhatsApp number + message
        let phone = "911234567890"; // CHANGE NUMBER HERE
        let message = encodeURIComponent("Request Approved");

        let url = "https://wa.me/" + phone + "?text=" + message;
        window.location.href = url;
    }

    function rejectAction() {
        document.getElementById("rejectBtn").classList.add("reject-active");

        // Redirect to another webpage
        window.location.href = "rejectpage.html"; // CHANGE PAGE HERE
    }
</script>

</body>
</html>
